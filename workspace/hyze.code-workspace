        "command": "pnpm install",
        "options": {
          "cwd": "${workspaceFolder:hyze-leads-api}"
        },
        "problemMatcher": []
      },
      {
        "label": "Hyze: instalar dependências",
        "dependsOrder": "sequence",
        "dependsOn": [
          "instalar: hyze-ui",
          "instalar: hyze-hub",
          "instalar: hyze-sites",
          "instalar: hyze-consultoria",
          "instalar: hyze-leads-api"
